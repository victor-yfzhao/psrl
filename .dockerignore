# Only Docker build inputs and dependency patches enter the context.
**
!.dockerignore
!docker/
docker/*
!docker/Dockerfile
!docker/Dockerfile.cpu
!docker/constraints.txt
!docker/env.sh
!patch/
patch/*
!patch/vllm/
patch/vllm/*
!patch/vllm/v0.22.0.patch
!patch/verl/
patch/verl/*
!patch/verl/e5ca4acb.patch
!patch/ucx/
patch/ucx/*
!patch/ucx/v1.20.0.patch
!patch/nixl/
patch/nixl/*
!patch/nixl/1.2.0.patch
!patch/megatron_bridge/
patch/megatron_bridge/*
!patch/megatron_bridge/94d1870.patch
!patch/megatron_bridge/dependencies.patch
!patch/lm_cache/
patch/lm_cache/*
!patch/lm_cache/a7f22be7.patch
!patch/lm_cache/dependencies.patch
!patch/transfer_queue/
patch/transfer_queue/*
!patch/transfer_queue/434f8c47.patch
