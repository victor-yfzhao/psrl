+
+            # Unpack: by peer, then by dst_slot order.
+            cursor = 0
+            for peer in range(ep_size):
+                for (_src_slot, dst_slot) in recv_plan[peer]:
+                    for t in slot_state_views[dst_slot]:
+                        n = int(t.numel())
+                        t.copy_(recvbuf[cursor : cursor + n])
+                        cursor += n
+            if cursor != total_recv:
+                raise RuntimeError(
+                    f"Internal unpacking error: cursor={cursor} total_recv={total_recv}"
+                )
+
+            self._logical_to_physical_expert_mapping_by_layer[layer_idx] = new_l2p.detach().clone().to(
+                device="cpu"
+            )
+
