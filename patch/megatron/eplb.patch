+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Optional, Tuple
+
+import threading
+
+import torch
+import torch.distributed
+
+@dataclass
+class _TEGroupedMLPExpertState:
+    fc1_weight: torch.Tensor
+    fc2_weight: torch.Tensor
+
+
+class MoEExpertWeightManager:
+    """Manages per-layer MoE expert weights cached on CPU and supports async CPU<->GPU copies.
+
+    This manager is intentionally lightweight and inference-only:
+    - No optimizer/grad support.
+    - Copies are done via a dedicated CUDA stream to overlap with compute.
+
+    Notes/assumptions (can be extended later):
+    - Currently supports experts implementations where per-expert weights can be sliced/assigned
+      efficiently (GroupedMLP, SequentialMLP).
+    - The CPU cache stores this-rank's TP shard for each expert.
+    """
+
+    def __init__(self, device: Optional[torch.device] = None):
+        self._device = device
+        self._copy_stream: Optional[torch.cuda.Stream] = None
+        self._refresh_stream: Optional[torch.cuda.Stream] = None
+
+        # layer_number -> (logical_expert_id -> state)
+        self._cpu_cache: Dict[int, Dict[int, object]] = {}
+
+        # layer_number -> (microbatch_id last scheduled, cuda event)
+        self._layer_load_event: Dict[int, Tuple[int, torch.cuda.Event]] = {}
+
+        # CPU refresh event (global)
+        self._cpu_refresh_event: Optional[torch.cuda.Event] = None
+        self._cpu_refresh_pending: bool = False
+
+        # Background refresh task state (thread-based to share _cpu_cache).
+        self._cpu_refresh_thread: Optional[threading.Thread] = None
+        self._cpu_refresh_thread_exc: Optional[BaseException] = None
+
+    def start_cpu_refresh_background(self, refresh_fn) -> None:
+        """Run a refresh function in a background thread and return immediately.
+
+        Note: we use a thread (not a process) because the refresh populates this manager's
+        in-memory `_cpu_cache`, which must be visible to the main process.
+        """
+
+        # If a refresh is already running, do not start another one.
+        if self._cpu_refresh_thread is not None and self._cpu_refresh_thread.is_alive():
+            return
+
+        self._cpu_refresh_thread_exc = None
+        self._cpu_refresh_pending = True
+
+        def _runner():
+            try:
+                refresh_fn()
+            except BaseException as e:
+                self._cpu_refresh_thread_exc = e
+            finally:
+                # Pending stays True until wait_for_cpu_refresh_if_needed consumes it.
+                return
+
+        self._cpu_refresh_thread = threading.Thread(
+            target=_runner, name='MoEExpertWeightManager.cpu_refresh', daemon=True
+        )
+        self._cpu_refresh_thread.start()
+
+    def _ensure_streams(self):
+        if not torch.cuda.is_available():
+            raise RuntimeError("MoEExpertWeightManager requires CUDA")
+        if self._copy_stream is None:
+            self._copy_stream = torch.cuda.Stream()
+        if self._refresh_stream is None:
+            # self._refresh_stream = torch.cuda.Stream()
+            self._refresh_stream = torch.cuda.current_stream()
+
+    def is_layer_load_scheduled(self, *, layer_number: int, microbatch_id: int) -> bool:
+        pair = self._layer_load_event.get(int(layer_number), None)
+        if pair is None:
+            return False
+        scheduled_mb, _ = pair
+        return int(scheduled_mb) == int(microbatch_id)
+
+    def wait_for_cpu_refresh_if_needed(self) -> None:
+        # # If a background refresh thread exists, wait for it to finish first.
+        # if self._cpu_refresh_thread is not None:
+        #     self._cpu_refresh_thread.join()
+        #     self._cpu_refresh_thread = None
+
+        # if self._cpu_refresh_thread_exc is not None:
+        #     exc = self._cpu_refresh_thread_exc
+        #     self._cpu_refresh_thread_exc = None
+        #     self._cpu_refresh_pending = False
+        #     raise RuntimeError('CPU refresh background task failed') from exc
+
+        if not self._cpu_refresh_pending:
+            return
+        if self._cpu_refresh_event is not None:
+            torch.cuda.current_stream().wait_event(self._cpu_refresh_event)
+        self._cpu_refresh_pending = False
+
+
+    def _start_cpu_refresh_te_grouped_mlp_all_experts(
+        self,
+        *,
+        layer_number: int,
+        experts_module,
+        ep_group,
+        num_local_experts: int,
+        physical_to_logical: Optional[torch.Tensor] = None,
+    ) -> None:
+        """Async refresh CPU cache for all global experts in this layer (TEGroupedMLP).
+
+        Gathers TE GroupedLinear weights (fc1/fc2) across EP ranks, storing on pinned CPU.
+        """
+        if getattr(experts_module, 'config', None) is not None and getattr(
+            experts_module.config, 'fp8', False
+        ):
+            raise NotImplementedError(
+                "TEGroupedMLP fp8 mode is not supported for expert weight swapping yet"
+            )
+
+        self._ensure_streams()
+
+        if layer_number not in self._cpu_cache:
+            self._cpu_cache[layer_number] = {}
+
+        ep_size = ep_group.size()
+        num_local_experts = int(num_local_experts)
+        num_global_experts = ep_size * num_local_experts
+
+        def _stack_weights(linear_module) -> torch.Tensor:
+            ws = [getattr(linear_module, f'weight{i}').detach().contiguous() for i in range(num_local_experts)]
+            return torch.stack(ws, dim=0)
+
+        with torch.cuda.stream(self._refresh_stream):
+            fc1_local = _stack_weights(experts_module.linear_fc1)
+            fc2_local = _stack_weights(experts_module.linear_fc2)
+
+            fc1_gather = [torch.empty_like(fc1_local) for _ in range(ep_size)]
+            fc2_gather = [torch.empty_like(fc2_local) for _ in range(ep_size)]
+            torch.distributed.all_gather(fc1_gather, fc1_local, group=ep_group)
+            torch.distributed.all_gather(fc2_gather, fc2_local, group=ep_group)
+
+            for ep_rank in range(ep_size):
+                cpu_fc1_rank = torch.empty(
+                    fc1_gather[ep_rank].shape,
+                    dtype=fc1_gather[ep_rank].dtype,
+                    device='cpu',
+                    pin_memory=True,
+                )
+                cpu_fc2_rank = torch.empty(
+                    fc2_gather[ep_rank].shape,
+                    dtype=fc2_gather[ep_rank].dtype,
+                    device='cpu',
+                    pin_memory=True,
+                )
+                cpu_fc1_rank.copy_(fc1_gather[ep_rank], non_blocking=False)
+                cpu_fc2_rank.copy_(fc2_gather[ep_rank], non_blocking=False)
+
+                base_global = ep_rank * num_local_experts
+                for local_slot in range(num_local_experts):
+                    physical_expert_id = base_global + local_slot
+                    logical_expert_id = (
+                        int(physical_to_logical[physical_expert_id].item())
+                        if physical_to_logical is not None
+                        else int(physical_expert_id)
+                    )
+                    self._cpu_cache[layer_number][logical_expert_id] = _TEGroupedMLPExpertState(
+                        fc1_weight=cpu_fc1_rank[local_slot],
+                        fc2_weight=cpu_fc2_rank[local_slot],
+                    )
