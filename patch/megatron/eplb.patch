+    def _invert_permutation(logical_to_physical: torch.Tensor) -> torch.Tensor:
+        """Invert a permutation mapping.
+
+        Args:
+            logical_to_physical: 1D int64 tensor where mapping[l] = p.
+
+        Returns:
+            physical_to_logical: 1D int64 tensor where inv[p] = l.
+        """
+        if logical_to_physical.dtype != torch.int64:
+            logical_to_physical = logical_to_physical.to(dtype=torch.int64)
+        num_experts = int(logical_to_physical.numel())
+        physical_to_logical = torch.empty_like(logical_to_physical)
+        physical_to_logical.scatter_(
+            0,
+            logical_to_physical,
+            torch.arange(num_experts, device=logical_to_physical.device, dtype=torch.int64),
+        )
+        return physical_to_logical
