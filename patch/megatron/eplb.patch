+        #     event = torch.cuda.Event()
+        #     event.record(self._refresh_stream)
+        #     self._cpu_refresh_event = event
+
+        # self._cpu_refresh_pending = True
+
+    def start_cpu_refresh_all_experts(
+        self,
+        *,
+        layer_number: int,
+        experts_module,
+        ep_group,
+        num_local_experts: int,
+        physical_to_logical: Optional[torch.Tensor] = None,
+    ) -> None:
+        from megatron.core.transformer.moe.experts import TEGroupedMLP
+
+        if isinstance(experts_module, TEGroupedMLP):
+            self._start_cpu_refresh_te_grouped_mlp_all_experts(
+                layer_number=layer_number,
+                experts_module=experts_module,
+                ep_group=ep_group,
+                num_local_experts=num_local_experts,
+                physical_to_logical=physical_to_logical,
+            )
+        else:
+            raise NotImplementedError(
+                "CPU refresh currently supports GroupedMLP and TEGroupedMLP only"
+            )
+
+    @staticmethod
+    def invert_logical_to_physical(logical_to_physical: torch.Tensor) -> torch.Tensor:
+        """Compute physical_to_logical from logical_to_physical.
+
+        Expects a 1D int64 mapping of length num_experts.
+        """
+        assert logical_to_physical.dim() == 1
+        if logical_to_physical.dtype != torch.int64:
+            logical_to_physical = logical_to_physical.to(dtype=torch.int64)
+        num_experts = logical_to_physical.numel()
+        device = logical_to_physical.device
+        physical_to_logical = torch.empty((num_experts,), dtype=torch.int64, device=device)
+        physical_to_logical.scatter_(0, logical_to_physical, torch.arange(num_experts, device=device, dtype=torch.int64))
+        return physical_to_logical
+
+
+    @torch.no_grad()
+    def _schedule_te_grouped_mlp_load_for_microbatch(
+        self,
+        *,
+        layer_number: int,
+        experts_module,
+        local_expert_global_ids: torch.Tensor,
+        physical_to_logical: torch.Tensor,
+        microbatch_id: int,
+        compute_event = None
+    ) -> None:
+        """Schedule async CPU->GPU copies for TEGroupedMLP expert weights."""
+        if getattr(experts_module, 'config', None) is not None and getattr(
+            experts_module.config, 'fp8', False
+        ):
+            raise NotImplementedError(
+                "TEGroupedMLP fp8 mode is not supported for expert weight swapping yet"
+            )
+
+        self._ensure_streams()
+        assert self._copy_stream is not None
+
+        if layer_number not in self._cpu_cache:
+            raise RuntimeError(f"No CPU cache for MoE layer {layer_number}")
+
+        desired_logical_global_ids = physical_to_logical.index_select(0, local_expert_global_ids)
+        desired_logical_list = desired_logical_global_ids.tolist()
+        for logical_id in desired_logical_list:
+            if logical_id not in self._cpu_cache[layer_number]:
+                raise KeyError(
+                    f"CPU cache miss for layer {layer_number} logical_expert_id {logical_id}. "
+                    f"Initialize/refresh the CPU cache for all experts first."
+                )
+
+        with torch.cuda.stream(self._copy_stream):
+            if compute_event is not None:
+                self._copy_stream.wait_event(compute_event)
+            for local_slot, logical_id in enumerate(desired_logical_list):
+                state = self._cpu_cache[layer_number][logical_id]
+                if not isinstance(state, _TEGroupedMLPExpertState):
+                    raise TypeError(
+                        f"Unsupported expert state type for TEGroupedMLP load: {type(state).__name__}"
+                    )
+                fc1 = getattr(experts_module.linear_fc1, f'weight{local_slot}')
+                fc2 = getattr(experts_module.linear_fc2, f'weight{local_slot}')
+                fc1.copy_(state.fc1_weight, non_blocking=True)
+                fc2.copy_(state.fc2_weight, non_blocking=True)
+
+            event = torch.cuda.Event()
+            event.record(self._copy_stream)
+            self._layer_load_event[layer_number] = (int(microbatch_id), event)
+
+    @torch.no_grad()
+    def schedule_experts_load_for_microbatch(
+        self,
+        *,
+        layer_number: int,
+        experts_module,
+        local_expert_global_ids: torch.Tensor,
+        physical_to_logical: torch.Tensor,
+        microbatch_id: int,
+        compute_event = None
+    ) -> None:
+        from megatron.core.transformer.moe.experts import TEGroupedMLP
+
+        if isinstance(experts_module, TEGroupedMLP):
+            self._schedule_te_grouped_mlp_load_for_microbatch(
+                layer_number=layer_number,
+                experts_module=experts_module,
+                local_expert_global_ids=local_expert_global_ids,
+                physical_to_logical=physical_to_logical,
+                microbatch_id=microbatch_id,
+                compute_event=compute_event,
+            )
+        else:
+            raise NotImplementedError(
+                "Per-micro-batch expert weight reload currently supports GroupedMLP and TEGroupedMLP only"
+            )
+
+
+    @torch.no_grad()
+    def schedule_experts_load_for_microbatch_all_to_all(
+        self,
+        *,
+        layer_number: int,
+        experts_module,
+        local_expert_global_ids: torch.Tensor,
+        next_p2l: torch.Tensor,
+        next_l2p: torch.Tensor,
+        cur_p2l: torch.Tensor,
+        cur_l2p: torch.Tensor,
+        microbatch_id: int,
+        ep_group,
+        ep_size: int,
+        ep_rank: int,
+        compute_event = None
+    ) -> None:
+        # 假设本函数接受的tensor均位于cpu上，避免不必要的同步
+        self._ensure_streams()
+        assert self._copy_stream is not None
+
+        num_local_experts = int(local_expert_global_ids.numel())
+
+        # send_slots_by_dst_rank[dst_rank] = list of local src_slot (in increasing order)
+        send_slots_by_dst_rank: list[list[int]] = [[] for _ in range(ep_size)]
+        base_old = ep_rank * num_local_experts
+        for src_slot in range(num_local_experts):
+            physical_old = base_old + src_slot
+            logical_id = int(cur_p2l[physical_old].item())
+            physical_new = int(next_l2p[logical_id].item())
+            dst_rank = physical_new // num_local_experts
+            send_slots_by_dst_rank[int(dst_rank)].append(int(src_slot))
+
+        # recv_pairs_by_src_rank[src_rank] = list[(src_slot, dst_slot)] sorted by src_slot
+        recv_pairs_by_src_rank: list[list[tuple]] = [[] for _ in range(ep_size)]
+        base_new = ep_rank * num_local_experts
+        for dst_slot in range(num_local_experts):
+            physical_new = base_new + dst_slot
+            logical_needed = int(next_p2l[physical_new].item())
+            physical_old = int(cur_l2p[logical_needed].item())
+            src_rank = physical_old // num_local_experts
+            src_slot = physical_old % num_local_experts
+            recv_pairs_by_src_rank[int(src_rank)].append((int(src_slot), int(dst_slot)))
+        for src_rank in range(ep_size):
+            recv_pairs_by_src_rank[src_rank].sort(key=lambda x: x[0])
+
+        def _permute_te_grouped_linear_weights_inplace(linear_module) -> None:
+            # Gather per-slot parameters.
+            slot_params = [getattr(linear_module, f'weight{i}') for i in range(num_local_experts)]
+            if len(slot_params) == 0:
+                return
+            dtype = slot_params[0].dtype
+            device = slot_params[0].device
+            chunk_numel = int(slot_params[0].numel())
+            total_elems = num_local_experts * chunk_numel
+            sendbuf = torch.empty((total_elems,), dtype=dtype, device=device)
+            recvbuf = torch.empty((total_elems,), dtype=dtype, device=device)
+
+            input_split_sizes = [len(send_slots_by_dst_rank[r]) * chunk_numel for r in range(ep_size)]
+            output_split_sizes = [len(recv_pairs_by_src_rank[r]) * chunk_numel for r in range(ep_size)]
+            if sum(input_split_sizes) != total_elems or sum(output_split_sizes) != total_elems:
+                raise RuntimeError(
+                    "Invalid all-to-all split sizes for expert permutation "
+                    f"(send={sum(input_split_sizes)}, recv={sum(output_split_sizes)}, expected={total_elems})"
+                )
+
+            # Pack send buffer: grouped by dst_rank, preserving increasing src_slot order.
+            offset = 0
+            for dst_rank in range(ep_size):
+                for src_slot in send_slots_by_dst_rank[dst_rank]:
+                    src_flat = slot_params[src_slot].detach().contiguous().view(-1)
+                    sendbuf[offset : offset + chunk_numel].copy_(src_flat)
+                    offset += chunk_numel
+
+            torch.distributed.all_to_all_single(
+                recvbuf,
+                sendbuf,
+                output_split_sizes=output_split_sizes,
+                input_split_sizes=input_split_sizes,
+                group=ep_group,
+                async_op=False
+            )
+
+            # Unpack recv buffer: grouped by src_rank, in increasing src_slot order.
+            offset = 0
+            for src_rank in range(ep_size):
+                for _, dst_slot in recv_pairs_by_src_rank[src_rank]:
+                    dst_param = slot_params[dst_slot]
+                    dst_param.copy_(recvbuf[offset : offset + chunk_numel].view_as(dst_param))
+                    offset += chunk_numel
+
+        with torch.cuda.stream(self._copy_stream):
+            if compute_event is not None:
+                self._copy_stream.wait_event(compute_event)
+
+            _permute_te_grouped_linear_weights_inplace(experts_module.linear_fc1)
+            _permute_te_grouped_linear_weights_inplace(experts_module.linear_fc2)
+
+            event = torch.cuda.Event()
+            event.record(self._copy_stream)
+            self._layer_load_event[layer_number] = (int(microbatch_id), event)
+
+
+
+    def wait_for_layer_load(self, *, layer_number: int, microbatch_id: int) -> None:
+        pair = self._layer_load_event.get(layer_number, None)
+        if pair is None:
+            return
+        scheduled_mb, event = pair
+        if scheduled_mb != int(microbatch_id):
+            return
+        torch.cuda.current_stream().wait_event(event)
+        del self._layer_load_event[layer_number]
+
+    def clear_cpu_cache(self) -> None:
+        self._cpu_cache.clear()
+    
